# Public build-time configuration for Scroll the Gita.
# Nothing here is a secret: these values ship in the page source by design
# (AdSense client/slot ids are public, and the Supabase anon key is protected
# by row-level security on the server — never by being hidden).
#
#   .env        (git-ignored) — your real values, read by `npm run build`
#   .env.example            — this template
#
# Until the Supabase values are set, the account feature shows an honest
# "not configured" state. Until the AdSense values are set, the ad slots
# render clearly-labelled empty placeholders — never fake ads.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_DAILY=
VITE_ADSENSE_SLOT_READER=
